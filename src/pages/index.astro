---
import { getEmDashCollection } from 'emdash';
import { PortableText } from 'emdash/ui';
import Site from '../layouts/Site.astro';
import JapanMap from '../components/JapanMap.astro';
import MediaTile from '../components/MediaTile.astro';
import ShopAd from '../components/ShopAd.astro';
import { buttonVariants } from '../components/ui/button';
import { Card, CardHeader, CardContent } from '../components/ui/card';
import { tripMedia } from '../lib/content';
import { formatDay, galleryIds } from '../lib/model';
const { entries: posts, nextCursor } = await getEmDashCollection('posts', {
  status: 'published',
  limit: 24,
  cursor: Astro.url.searchParams.get('cursor') || undefined,
  orderBy: { day: 'desc' },
});
const media = await tripMedia();
---

<Site>
  <div class="journal-grid grid grid-cols-1 auto-rows-[8px] items-start gap-4 min-[601px]:grid-cols-2 min-[901px]:grid-cols-3">
    <section class="journal-card journal-map-card min-w-0 min-[601px]:col-span-2">
      <Card className="journal-card-inner overflow-hidden border gap-0 py-0 shadow-none">
        <JapanMap media={media} />
      </Card>
    </section>
    {posts.map((post) => (
      <article
        class="journal-card min-w-0"
        data-feedback-id={`post-${post.data.id}`}
      >
        <Card className="journal-card-inner overflow-hidden border gap-0 py-0 shadow-none">
          <CardHeader className="post-heading flex flex-wrap items-center justify-between gap-2.5 p-4 [&_a]:no-underline">
            <h1>
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
            </h1>
            <time datetime={post.data.day}>{formatDay(post.data.day)}</time>
          </CardHeader>
          <CardContent className="post-body prose px-4 pb-0.5 [&_p]:mb-[17px] [&_h2]:mb-[15px] [&_h3]:mb-[15px] [&_a]:underline [&_img]:h-auto [&_img]:w-full [&_ul]:list-disc [&_ul]:pl-[23px] [&_ol]:list-decimal [&_ol]:pl-[23px] [&_ul]:pl-[23px] [&_ol]:pl-[23px]">
            <PortableText value={post.data.content} />
          </CardContent>
          <div
            class="post-media flex snap-x snap-mandatory gap-[5px] overflow-x-auto [&>*]:shrink-0 [&>*]:basis-[88%] [&>*]:snap-start min-[601px]:grid min-[601px]:grid-cols-2 min-[601px]:overflow-visible min-[601px]:[&>*:first-child]:col-span-2"
            aria-label={`${post.data.title} media`}
          >
            {galleryIds(post.data.gallery).flatMap((id) => {
              const item = media.find((m) => m.id === id);
              return item ? [<MediaTile item={item} inline />] : [];
            })}
          </div>
        </Card>
      </article>
    ))}
  </div>
  {nextCursor && (
    <a
      class={buttonVariants({ className: 'pagination my-6' })}
      href={`/?cursor=${encodeURIComponent(nextCursor)}`}
    >
      EARLIER →
    </a>
  )}
  <ShopAd />
</Site>
<script>
  const grid = document.querySelector('.journal-grid');
  function layout() {
    if (!(grid instanceof HTMLElement)) return;
    const style = getComputedStyle(grid),
      row = parseFloat(style.gridAutoRows),
      gap = parseFloat(style.rowGap);
    grid.querySelectorAll('.journal-card').forEach((card) => {
      const inner = card.querySelector('.journal-card-inner');
      if (card instanceof HTMLElement && inner)
        card.style.gridRowEnd = `span ${Math.ceil((inner.getBoundingClientRect().height + gap) / (row + gap))}`;
    });
  }
  const observer = new ResizeObserver(layout);
  document
    .querySelectorAll('.journal-card-inner')
    .forEach((el) => observer.observe(el));
  layout();
</script>
