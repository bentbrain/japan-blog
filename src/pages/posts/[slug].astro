---
import { getEmDashEntry } from 'emdash';
import TripContent from '../../components/TripContent.astro';
import Site from '../../layouts/Site.astro';
import ShopAd from '../../components/ShopAd.astro';
import { PostMedia } from '../../components/PostMedia';
import { tripMedia } from '../../lib/content';
import { formatDay, galleryIds } from '../../lib/model';
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');
const { entry: post } = await getEmDashEntry('posts', slug);
if (!post || post.data.status !== 'published') return Astro.rewrite('/404');
const media = await tripMedia();
---

<Site title={`${post.data.title} / jp.bent.build`}>
  <article class="single-post mx-auto max-w-[800px] [&_.post-body]:px-0 [&_.post-body]:py-4">
    <div class="post-heading flex flex-wrap items-center justify-between gap-2.5 p-4 [&_a]:no-underline">
      <h1>{post.data.title}</h1>
      <time datetime={post.data.day}>{formatDay(post.data.day)}</time>
    </div>
    <div class="post-body prose px-4 pb-0.5 [&_p]:mb-[17px] [&_h2]:mb-[15px] [&_h3]:mb-[15px] [&_a]:underline [&_img]:h-auto [&_img]:w-full [&_ul]:list-disc [&_ul]:pl-[23px] [&_ol]:list-decimal [&_ol]:pl-[23px] [&_ul]:pl-[23px] [&_ol]:pl-[23px]">
      <TripContent value={post.data.content} media={media} />
    </div>
    <PostMedia
      client:load
      title={post.data.title}
      design={post.data.shop_design}
      items={galleryIds(post.data.gallery).flatMap((id) => {
        const item = media.find((m) => m.id === id);
        return item ? [item] : [];
      })}
    />

    {!post.data.shop_design && <ShopAd />}
  </article>
</Site>
