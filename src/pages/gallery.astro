---
import Site from '../layouts/Site.astro';
import { buttonVariants } from '../components/ui/button';
import MediaTile from '../components/MediaTile.astro';
import ShopAd from '../components/ShopAd.astro';
import Pixel from '../components/Pixel.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { tripMedia } from '../lib/content';
import { env } from 'cloudflare:workers';
import { readyCategoryIcons } from '../lib/category-icon-jobs';
import { currentPublishedCategoryNames } from '../lib/category-icon-access';
import { normalizeCategory } from '../lib/category-icons';
const category = Astro.url.searchParams.get('category') || 'all';
const allMedia = await tripMedia();
const filterCategories = [
  ...new Set(allMedia.flatMap((item) => item.categories)),
];
const currentCategories = new Set(
  (await currentPublishedCategoryNames(env.DB)).map((name) => name.normalized),
);
const icons = await readyCategoryIcons(
  env,
  filterCategories.filter((name) =>
    currentCategories.has(normalizeCategory(name)?.normalized || ''),
  ),
);
Astro.cache.set(false);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const media = allMedia.filter(
  (item) => category === 'all' || item.categories.includes(category),
);
---

<Site title="gallery / jp.bent.build">
  {allMedia.length > 0 && (
    <nav
      class="filters mb-[18px] flex flex-wrap gap-2 [&_a]:inline-flex [&_a]:items-center [&_a]:gap-[7px] [&_a]:border [&_a]:px-3 [&_a]:py-2 [&_a]:no-underline [&_a[aria-current]]:bg-primary [&_a[aria-current]]:text-primary-foreground"
      aria-label="Media categories"
      data-feedback-id="gallery-filters"
    >
      {['all', ...filterCategories].map((name) => (
        <a
          class={buttonVariants({
            variant: category === name ? 'default' : 'outline',
          })}
          href={
            name === 'all'
              ? '/gallery'
              : `/gallery?category=${encodeURIComponent(name)}`
          }
          aria-current={category === name ? 'page' : undefined}
        >
          {name !== 'all' &&
            (['food', 'shopping', 'landscape', 'beer'].includes(
              normalizeCategory(name)?.normalized || '',
            ) ? (
              <Pixel name={normalizeCategory(name)?.normalized} centerPaint />
            ) : (
              <CategoryIcon
                url={icons.get(normalizeCategory(name)?.normalized || '')}
              />
            ))}
          {name}
        </a>
      ))}
    </nav>
  )}
  <div
    class="gallery-grid grid grid-cols-1 gap-[7px] min-[601px]:grid-cols-2 min-[901px]:grid-cols-3"
    data-feedback-id="gallery-grid"
  >
    {media.map((item) => (
      <MediaTile item={item} />
    ))}
  </div>
  {!media.length && <p>no photos yet</p>}
  <ShopAd />
</Site>
