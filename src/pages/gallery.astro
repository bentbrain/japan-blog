---
import Site from '../layouts/Site.astro';
import MediaTile from '../components/MediaTile.astro';
import ShopAd from '../components/ShopAd.astro';
import Pixel from '../components/Pixel.astro';
import { tripMedia } from '../lib/content';
import { categories } from '../lib/model';
const category = Astro.url.searchParams.get('category') || 'all';
const allMedia = await tripMedia();
const filterCategories = [
  ...new Set([...categories, ...allMedia.flatMap((item) => item.categories)]),
];
const media = allMedia.filter(
  (item) => category === 'all' || item.categories.includes(category),
);
---

<Site title="gallery / jp.bent.build">
  <nav
    class="filters"
    aria-label="Media categories"
    data-feedback-id="gallery-filters"
  >
    {['all', ...filterCategories].map((name) => (
      <a
        href={
          name === 'all'
            ? '/gallery'
            : `/gallery?category=${encodeURIComponent(name)}`
        }
        aria-current={category === name ? 'page' : undefined}
      >
        {['food', 'shopping', 'landscape', 'beer'].includes(name) && (
          <Pixel name={name} />
        )}
        {name}
      </a>
    ))}
  </nav>
  <div class="gallery-grid" data-feedback-id="gallery-grid">
    {media.map((item) => (
      <MediaTile item={item} />
    ))}
  </div>
  {!media.length && <p>no photos yet</p>}
  <ShopAd />
</Site>
