---
import Site from '../../layouts/Site.astro';
import Pixel from '../../components/Pixel.astro';
import { getEmDashCollection } from 'emdash';
import { tokyoDay } from '../../lib/model';
import { beerCounts } from '../../lib/content';
const { entries: posts } = await getEmDashCollection('posts', {
  status: undefined,
  limit: 100,
  orderBy: { day: 'desc' },
});
const day = tokyoDay(new Date()),
  counts = await beerCounts(day);
---

<Site owner>
  <div class="section-heading">
    <h1>posts</h1>
    <a class="button primary" href="/_emdash/admin/content/posts/new">
      NEW POST
    </a>
  </div>
  <table class="table" data-feedback-id="owner-post-list">
    <thead>
      <tr>
        <th>title</th>
        <th>day</th>
        <th>status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {posts.map((post) => (
        <tr>
          <td>{post.data.title}</td>
          <td>{post.data.day}</td>
          <td>{post.data.status}</td>
          <td>
            <a href={`/_emdash/admin/content/posts/${post.data.id}`}>EDIT</a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <form id="beer-form" class="beer-edit" data-feedback-id="daily-beer-editor">
    <Pixel />
    <input name="day" aria-label="Beer day" type="date" value={day} required />
    <button type="button" data-delta="-1" aria-label="Remove a beer">
      −
    </button>
    <input
      name="count"
      aria-label="Daily beers"
      type="number"
      min="0"
      max="100"
      value={counts.today}
      style="width:70px"
      required
    />
    <button type="button" data-delta="1" aria-label="Add a beer">
      +
    </button>
    <button type="submit" class="primary">
      SAVE
    </button>
  </form>
  <p class="status" role="status"></p>
  <a href="/_emdash/admin/account">passkeys & account</a>
</Site>
<script>
  import { api } from '../../lib/api-client';
  const form = document.querySelector('#beer-form');
  form?.querySelectorAll('[data-delta]').forEach((button) =>
    button.addEventListener('click', () => {
      const input = form.querySelector('[name=count]');
      if (input instanceof HTMLInputElement)
        input.value = String(
          Math.min(
            100,
            Math.max(
              0,
              Number(input.value) + Number(button.getAttribute('data-delta')),
            ),
          ),
        );
    }),
  );
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const values = new FormData(form),
      status = document.querySelector('.status');
    try {
      await api('/api/trip/beers', {
        day: values.get('day'),
        count: Number(values.get('count')),
      });
      if (status) status.textContent = 'saved';
    } catch (error) {
      if (status)
        status.textContent =
          error instanceof Error ? error.message : 'Save failed';
    }
  });
</script>
