---
import Site from '../../layouts/Site.astro';
import { tripMedia } from '../../lib/content';
import { tokyoDay, posterUrl } from '../../lib/model';
const media = await tripMedia(),
  days = [...new Set(media.map((m) => tokyoDay(m.captured_at)))]
    .sort()
    .reverse();
---

<Site owner title="export / jp.bent.build">
  <div class="section-heading">
    <h1>story export</h1>
    <span>1080 × 1920</span>
  </div>
  <div class="export-layout">
    <form id="export-form">
      <label>
        day
        <select name="day">
          {days.map((day) => (
            <option value={day}>{day}</option>
          ))}
        </select>
      </label>
      <div class="gallery-grid" id="export-selection">
        {media.map((item, i) => (
          <div class="select-media" data-day={tokyoDay(item.captured_at)}>
            <label>
              <input
                name="media"
                value={item.id}
                type="checkbox"
                checked={i < 15 && tokyoDay(item.captured_at) === days[0]}
              />
              <img src={posterUrl(item)} alt={item.title} />
            </label>
          </div>
        ))}
      </div>
      <label>
        beer counter
        <select name="counter">
          <option value="both">today + trip total</option>
          <option value="today">today</option>
          <option value="total">trip total</option>
          <option value="hidden">hidden</option>
        </select>
      </label>
      <label>
        <input id="safe-areas" type="checkbox" checked /> safe area guides
      </label>
      <div class="actions">
        <button type="button" id="play-preview">
          PLAY PREVIEW
        </button>
        <button type="button" data-format="mp4" class="primary">
          EXPORT MP4
        </button>
        <button type="button" data-format="png">
          EXPORT PNG
        </button>
        <button type="button" id="cancel-export" hidden>
          CANCEL
        </button>
      </div>
      <p id="export-status" class="status" role="status"></p>
      <a id="download" hidden>
        DOWNLOAD
      </a>
    </form>
    <div class="story" data-feedback-id="story-composition">
      <div id="story-preview"></div>
      <div class="story-guides"></div>
    </div>
  </div>
</Site>
<script>
  import { api } from '../../lib/api-client';
  import { storySchema, type Story } from '../../lib/story';
  import { loadStory, renderStory } from '../../lib/story-renderer';
  import { z } from 'zod';
  const form = document.querySelector('#export-form'),
    status = document.querySelector('#export-status'),
    preview = document.querySelector('#story-preview'),
    download = document.querySelector('#download');
  let story: Story | undefined,
    renderer: Awaited<ReturnType<typeof loadStory>> | undefined,
    generation = 0,
    playing = false,
    abort: AbortController | undefined,
    rendering = false;
  function message(text: string) {
    if (status) status.textContent = text;
  }
  async function update() {
    if (!(form instanceof HTMLFormElement) || rendering) return;
    playing = false;
    const revision = ++generation,
      data = new FormData(form),
      day = String(data.get('day'));
    form.querySelectorAll('.select-media').forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = el.dataset.day !== day;
    });
    const ids = Array.from(
      form.querySelectorAll('.select-media:not([hidden]) input:checked'),
    ).flatMap((el) => (el instanceof HTMLInputElement ? [el.value] : []));
    renderer?.dispose();
    renderer = undefined;
    story = undefined;
    preview?.replaceChildren();
    if (!ids.length) {
      message('select photos');
      return;
    }
    try {
      const next = storySchema.parse(
        await api('/api/trip/story', {
          day,
          ids,
          counter: data.get('counter'),
        }),
      );
      const loaded = await loadStory(next);
      if (generation !== revision) {
        loaded.dispose();
        return;
      }
      story = next;
      renderer = loaded;
      await loaded.draw(0);
      preview?.replaceChildren(loaded.canvas);
      message(`${ids.length} selected`);
    } catch (error) {
      message(error instanceof Error ? error.message : 'Preview failed');
    }
  }
  form?.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.id === 'safe-areas') {
      document
        .querySelector('.story-guides')
        ?.toggleAttribute('hidden', !target.checked);
      return;
    }
    if (target instanceof HTMLSelectElement && target.name === 'day') {
      form.querySelectorAll('[name=media]').forEach((el) => {
        if (el instanceof HTMLInputElement)
          el.checked =
            el.closest('.select-media')?.getAttribute('data-day') ===
            target.value;
      });
    }
    void update();
  });
  document.querySelector('#play-preview')?.addEventListener('click', () => {
    playing = !playing;
    const started = performance.now();
    async function frame() {
      if (!playing || !renderer || rendering) return;
      await renderer.draw((performance.now() - started) / 1000);
      requestAnimationFrame(() => {
        void frame();
      });
    }
    void frame();
  });
  document
    .querySelector('#cancel-export')
    ?.addEventListener('click', () => abort?.abort());
  form?.querySelectorAll('[data-format]').forEach((button) =>
    button.addEventListener('click', async () => {
      if (!story || rendering) return;
      const format =
        button.getAttribute('data-format') === 'png' ? 'png' : 'mp4';
      playing = false;
      rendering = true;
      abort = new AbortController();
      const cancel = document.querySelector('#cancel-export');
      cancel?.removeAttribute('hidden');
      form
        .querySelectorAll('input,select,button[data-format]')
        .forEach((el) => {
          if (
            el instanceof HTMLInputElement ||
            el instanceof HTMLSelectElement ||
            el instanceof HTMLButtonElement
          )
            el.disabled = true;
        });
      try {
        message('rendering');
        const blob = await renderStory(
          story,
          format,
          (value) => message(`rendering ${Math.round(value * 100)}%`),
          abort.signal,
        );
        message('saving');
        const data = new FormData();
        data.set(
          'file',
          new File([blob], `japan-story-${story.day}.${format}`, {
            type: blob.type,
          }),
        );
        const response = await fetch('/api/trip/exports', {
          method: 'POST',
          headers: { 'X-EmDash-Request': '1' },
          body: data,
        });
        if (!response.ok) throw new Error('Could not save export');
        const result = z
          .object({ url: z.string() })
          .parse(await response.json());
        if (download instanceof HTMLAnchorElement) {
          download.href = result.url;
          download.download = `japan-story-${story.day}.${format}`;
          download.hidden = false;
          download.click();
        }
        message('ready');
      } catch (error) {
        message(
          abort.signal.aborted
            ? 'cancelled'
            : error instanceof Error
              ? error.message
              : 'Export failed',
        );
      } finally {
        rendering = false;
        cancel?.setAttribute('hidden', '');
        form
          .querySelectorAll('input,select,button[data-format]')
          .forEach((el) => {
            if (
              el instanceof HTMLInputElement ||
              el instanceof HTMLSelectElement ||
              el instanceof HTMLButtonElement
            )
              el.disabled = false;
          });
      }
    }),
  );
  void update();
</script>
