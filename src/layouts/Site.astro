---
import '../styles/globals.css';
import Pixel from '../components/Pixel.astro';
import { beerCounts } from '../lib/content';
import { feedbackConfiguration } from '../lib/feedback';
interface Props {
  title?: string;
  owner?: boolean;
}
const { title = 'jp.bent.build', owner = false } = Astro.props;
const counts = await beerCounts();
const feedback = feedbackConfiguration(
  import.meta.env.PUBLIC_FEEDBACK_SERVER,
  import.meta.env.PUBLIC_FEEDBACK_PROJECT_ID,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0647ff" />
    <meta name="description" content="Japan travel journal" />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/brand/favicon.svg?v=blue-flag"
    />
    {owner && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <header class="site-header flex flex-wrap items-center justify-between gap-2 border-b px-4 py-[13px] min-[601px]:flex-nowrap min-[601px]:gap-[18px] min-[601px]:px-6 min-[601px]:py-[15px] [&_nav]:order-3 [&_nav]:flex [&_nav]:w-full [&_nav]:gap-5 [&_nav]:border-t [&_nav]:pt-[7px] min-[601px]:[&_nav]:order-none min-[601px]:[&_nav]:w-auto min-[601px]:[&_nav]:border-0 min-[601px]:[&_nav]:p-0 [&_nav_a]:no-underline [&_nav_a[aria-current]]:underline">
      <a
        class="brand inline-flex items-center gap-2 whitespace-nowrap no-underline"
        data-feedback-id="brand"
        href={owner ? '/owner' : '/'}
      >
        <img
          src="/brand/favicon.svg"
          alt=""
          width="32"
          height="32"
          class="size-6 shrink-0"
        />
        jp.bent.build{owner ? ' / admin' : ''}
      </a>
      <nav aria-label="Main navigation" data-feedback-id="navigation">
        {owner ? (
          <>
            <a href="/owner">posts</a>
            <a href="/owner/media">media</a>
            <a href="/owner/export">export</a>
          </>
        ) : (
          <>
            <a
              href="/"
              aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
            >
              journal
            </a>
            <a
              href="/gallery"
              aria-current={
                Astro.url.pathname === '/gallery' ? 'page' : undefined
              }
            >
              gallery
            </a>
          </>
        )}
      </nav>
      <div
        class="beer flex items-center gap-[7px] whitespace-nowrap"
        data-feedback-id="beer-counter"
      >
        <Pixel />
        <span>{counts.total} beers</span>
      </div>
    </header>
    <main
      data-feedback-private={owner ? true : undefined}
      class="mx-auto max-w-[1400px] p-4 min-[601px]:p-6"
    >
      <slot />
    </main>
    {feedback && (
      <script
        is:inline
        defer
        src={`${feedback.server}/embed.js`}
        data-project={feedback.projectId}
      ></script>
    )}
  </body>
</html>
