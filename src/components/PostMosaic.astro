---
import MediaTile from './MediaTile.astro';
import { PostDesign } from './PostDesign';
import { type TripMedia } from '../lib/model';
import { postMosaicImageSizes, postImageSizes } from '../lib/responsive-image';
import { shopDesignSchema } from '../lib/shop-design';
interface Props {
  items: TripMedia[];
  title: string;
  design?: unknown;
}
const { items, title } = Astro.props;
const parsed = shopDesignSchema.safeParse(Astro.props.design);
const design = parsed.success ? parsed.data : undefined;
---

{(items.length > 0 || design) && (
  <section class="post-mosaic" aria-label={`${title} media`}>
    {items.length > 0 && (
      <div class="columns-1 gap-[7px] min-[601px]:@min-[553px]/post:columns-2">
        {items.map((item, index) => {
          const fullWidth = items.length % 2 === 1 && index === 0;
          return (
            <div
              class:list={[
                'mb-[7px] min-w-0 break-inside-avoid [&_.media-tile_img]:max-h-[70svh] [&_.media-tile_img]:object-contain [&_.media-tile_video]:max-h-[70svh] [&_.media-tile_video]:object-contain',
                fullWidth && '[column-span:all]',
              ]}
            >
              <MediaTile
                item={item}
                sizes={fullWidth ? postImageSizes : postMosaicImageSizes}
              />
            </div>
          );
        })}
      </div>
    )}
    {design && (
      <div class="mx-auto mt-4 max-w-[452px] pb-4">
        <PostDesign design={design} />
      </div>
    )}
  </section>
)}
