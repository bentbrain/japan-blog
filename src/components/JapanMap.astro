---
import { tripMap } from '../lib/map';
import { mediaUrl, posterUrl, type TripMedia } from '../lib/model';
interface Props {
  media: TripMedia[];
}
const { media } = Astro.props;
const { projectMedia, land } = tripMap(media);
import { JapanMapView } from './JapanMapView';
const points = media.flatMap((item) => {
  const point = projectMedia(item);
  if (!point) return [];
  const [x = 0, y = 0] = point;
  return [
    {
      x,
      y,
      id: item.id,
      slug: item.slug,
      title: item.title,
      place: item.place,
      kind: item.kind,
      src: mediaUrl(item),
      poster: posterUrl(item),
    },
  ];
});
---

<JapanMapView land={land || ''} points={points} client:load />
