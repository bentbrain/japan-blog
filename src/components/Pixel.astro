---
interface Props {
  name?: string;
  compact?: boolean;
}
const { name = 'beer', compact = false } = Astro.props;
const counterIcon = compact && name === 'beer';
const sprites: Record<string, string[]> = {
  beer: [
    '0000000000000000',
    '0000000000000000',
    '0001111111100000',
    '0011000000110000',
    '0010000000111100',
    '0010101010100100',
    '0010101010100100',
    '0010101010100100',
    '0010101010100100',
    '0010101010111100',
    '0010101010100000',
    '0010101010100000',
    '0010101010100000',
    '0010000000100000',
    '0001111111000000',
    '0000000000000000',
  ],
  food: [
    '0000000110000000',
    '0000001001000000',
    '0000010000100000',
    '0000100000010000',
    '0001000000001000',
    '0010000000000100',
    '0100000000000010',
    '0100000000000010',
    '0100001111000010',
    '0100001111000010',
    '0100001111000010',
    '0010001111000100',
    '0001111111111000',
  ],
  shopping: [
    '0000011111000000',
    '0000100000100000',
    '0000100000100000',
    '0001111111110000',
    '0001000000010000',
    '0001000000010000',
    '0001000000010000',
    '0001000000010000',
    '0001000000010000',
    '0001111111110000',
  ],
  landscape: [
    '0000000110000000',
    '0000001111000000',
    '0000010110100000',
    '0000100000010000',
    '0001000000001000',
    '0010000000000100',
    '0100000000000010',
    '0111111111111110',
  ],
};
const sprite = sprites[name] || sprites.beer || [];
const path = sprite
  .flatMap((row, y) =>
    row
      .split('')
      .flatMap((bit, x) => (bit === '1' ? [`M${x} ${y}h1v1h-1z`] : [])),
  )
  .join('');
---

<svg
  class:list={[
    'pixel shrink-0',
    counterIcon ? 'h-[1cap] w-[calc(12cap/13)]' : 'size-[1.7em] align-middle',
  ]}
  data-feedback-id={counterIcon ? 'beer-icon' : undefined}
  viewBox={counterIcon ? '2 2 12 13' : '0 0 16 16'}
  aria-hidden="true"
  shape-rendering="crispEdges"
>
  <path d={path} fill="currentColor" />
</svg>
