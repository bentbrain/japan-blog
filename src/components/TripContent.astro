---
import type { ComponentProps } from 'astro/types';
import { PortableText } from 'emdash/ui';
import InlinePhoto from './InlinePhoto.astro';
import InlineGallery from './InlineGallery.astro';
import TripCode from './TripCode.astro';
import type { TripMedia } from '../lib/model';
interface Props {
  value: ComponentProps<typeof PortableText>['value'];
  media: TripMedia[];
}
const { value, media } = Astro.props;
Astro.locals.publishedTripMedia = media;
---

<div class="rich-text min-w-0">
  <PortableText
    value={value}
    components={{
      type: { image: InlinePhoto, gallery: InlineGallery, code: TripCode },
    }}
  />
</div>
