{
  "name": "japan-blog",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Blog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm build",
    "demo": "tsx scripts/seed-demo.ts",
    "lint": "astro sync && eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "E2E_TIER=full playwright test",
    "test:e2e:coverage": "tsx scripts/verify-browser-coverage.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^6.0.6",
    "@base-ui/react": "^1.9.0",
    "@emdash-cms/cloudflare": "^1.0.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@react-email/render": "^2.2.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/pm": "3.31.4",
