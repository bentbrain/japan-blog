    "@tiptap/starter-kit": "3.31.4",
    "astro": "^7.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "embla-carousel-react": "^8.6.0",
    "emdash": "^1.0.1",
    "exifr": "^7.1.3",
    "fast-png": "8.0.0",
    "heic-to": "1.6.7",
    "lucide-react": "^1.66.0",
    "mediabunny": "1.65.0",
    "pbf": "^5.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
